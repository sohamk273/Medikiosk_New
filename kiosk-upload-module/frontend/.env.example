# Frontend Environment Configuration for LAN Testing
# Set this to your backend server URL reachable by physical mobile devices on your Wi-Fi/Hotspot:
# (Leave empty or commented out to default to relative /api/v1 proxied by Vite dev server)
# VITE_API_BASE_URL=http://<YOUR_LAN_IP>:8010
VITE_API_BASE_URL=http://localhost:8010
