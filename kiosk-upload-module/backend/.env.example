# Kiosk Document Upload Module Backend Environment Configuration
APP_NAME="Kiosk Document Upload Module"
APP_ENV="development"
DEBUG=true

# Server binding
HOST="0.0.0.0"
PORT=8010

# LAN Testing Configuration
# Set LAN_HOST to your computer's Wi-Fi / Hotspot IPv4 address (e.g. 10.245.196.130 or 192.168.1.100).
# When set, generated QR codes will embed this IP so physical phones on the same network can reach it.
# Leave empty to default to localhost for local testing.
LAN_HOST=
# Alternatively, specify the full public/LAN frontend URL explicitly:
PUBLIC_WEB_URL=

# Database connection string
DATABASE_URL="sqlite+aiosqlite:///./kiosk_upload.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/kiosk_upload"

# MinIO Object Storage
MINIO_ENDPOINT="localhost:9000"
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadminpassword"
MINIO_BUCKET="kiosk-uploads"
MINIO_SECURE=false

# Session and upload constraints
DEFAULT_SESSION_TTL_SECONDS=600
MAX_FILE_SIZE_MB=15
CORS_ALLOWED_ORIGINS=["*"]
