# MediKiosk Backend Environment Configuration
APP_NAME=MediKiosk Core API
APP_ENV=development
DEBUG=true

# Database (PostgreSQL)
# Async URL for FastAPI application (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/medikiosk
# Sync URL for Alembic migrations (psycopg)
DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@localhost:5432/medikiosk

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=medikiosk-documents
MINIO_SECURE=false

# CORS (Comma-separated or JSON list of allowed origins)
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
